    <marc:datafield tag="245" ind1="1" ind2="0">
      <marc:subfield code="a">Predicting crack pattern on archimedes screw runner blade of micro hydro power /</marc:subfield>
      <marc:subfield code="c">Ahmad Alif Ahmad Adam</marc:subfield>
