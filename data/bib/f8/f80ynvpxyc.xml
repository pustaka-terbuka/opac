    <marc:datafield tag="245" ind1="1" ind2="0">
      <marc:subfield code="a">Habits and motives of reading newspaper among students in Al-Beroni University of Afghanistan /</marc:subfield>
      <marc:subfield code="c">Ahmad Jaheq Mushtaq</marc:subfield>
