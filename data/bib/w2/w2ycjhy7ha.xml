    <marc:datafield tag="245" ind1="1" ind2="4">
      <marc:subfield code="a">The effect of different hydraulic retention tim (HRT) on biological pretreatment to chemical pulping /</marc:subfield>
      <marc:subfield code="c">Siti Nur Nadzmiah Binti Mohd Nor</marc:subfield>
